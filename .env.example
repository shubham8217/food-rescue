# Copy to .env:  Copy-Item .env.example .env
COMPOSE_PROFILES=core

POSTGRES_USER=foodrescue
POSTGRES_PASSWORD=foodrescue
POSTGRES_DB=foodrescue
POSTGRES_PORT=5433

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

JWT_SECRET=change-me-in-real-deployments

# Simulator also POSTs batches straight to /ingest/batch. Set false once NiFi owns data/inbox.
SIM_DIRECT_INGEST=true
