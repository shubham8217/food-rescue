# Copy to .env:  Copy-Item .env.example .env
COMPOSE_PROFILES=core

POSTGRES_USER=foodrescue
POSTGRES_PASSWORD=foodrescue
POSTGRES_DB=foodrescue
POSTGRES_PORT=5433

RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

JWT_SECRET=change-me-in-real-deployments

# Simulator also POSTs batches straight to /ingest/batch. Set false once NiFi owns data/inbox.
SIM_DIRECT_INGEST=true

# --- full stack (NiFi, Airflow, Elasticsearch): easiest is ./scripts/up-all.ps1 ---
INGEST_API_KEY=dev-ingest-key-change-me
AIRFLOW_ADMIN_PASSWORD=foodrescue123
# ELASTICSEARCH_URL=http://elasticsearch:9200
# NIFI_URL=http://nifi:8080
# AIRFLOW_URL=http://airflow:8080
# APP_ENV=production   # refuses to start with a weak JWT_SECRET
