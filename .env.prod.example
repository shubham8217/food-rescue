# Copy to .env.prod and fill EVERY value. Never commit .env.prod.
DOMAIN=localhost                 # your real domain for Let's Encrypt HTTPS

POSTGRES_USER=foodrescue
POSTGRES_DB=foodrescue
POSTGRES_PASSWORD=               # long random
RABBITMQ_USER=foodrescue
RABBITMQ_PASSWORD=               # long random

JWT_SECRET=                      # 32+ random characters (the app refuses to start otherwise)
INGEST_API_KEY=                  # long random, used by NiFi / Airflow

ADMIN_EMAIL=admin@your-org.org
ADMIN_PASSWORD=                  # 12+ characters; this is the only account created
